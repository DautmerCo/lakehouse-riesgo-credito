table fact_solicitudes
	lineageTag: df0b7d94-eda7-4154-967e-01ae494badca

	/// Número de solicitudes de crédito recibidas.
	measure Solicitudes = COUNTROWS ( fact_solicitudes )
		formatString: #,0
		displayFolder: Originación
		lineageTag: 46b7a9a9-afb6-4945-b34c-1c97fb657e9b

	/// Solicitudes que pasaron la política de crédito.
	measure 'Solicitudes aprobadas' = CALCULATE ( [Solicitudes], fact_solicitudes[aprobada] = TRUE () )
		formatString: #,0
		displayFolder: Originación
		lineageTag: a1a0592f-4e2c-490d-8335-af8b9df195be

	/// Solicitudes que terminaron en un préstamo desembolsado.
	measure 'Solicitudes desembolsadas' = CALCULATE ( [Solicitudes], fact_solicitudes[desembolsada] = TRUE () )
		formatString: #,0
		displayFolder: Originación
		lineageTag: bf110c8b-ae75-4113-b79f-576d58b9446d

	/// Solicitudes aprobadas sobre solicitudes recibidas.
	measure '% Aprobación' = DIVIDE ( [Solicitudes aprobadas], [Solicitudes] )
		formatString: 0.0%
		displayFolder: Originación
		lineageTag: 712bcc73-1789-48d9-aa86-a48ab61fe69c

	/// Solicitudes desembolsadas sobre solicitudes recibidas.
	measure '% Desembolso' = DIVIDE ( [Solicitudes desembolsadas], [Solicitudes] )
		formatString: 0.0%
		displayFolder: Originación
		lineageTag: b6d06046-ed95-41af-ba52-d516b455a722

