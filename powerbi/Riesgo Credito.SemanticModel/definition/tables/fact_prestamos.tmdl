table fact_prestamos
	lineageTag: 829161cb-8ac0-4914-a47d-856c15a2c9d3

	/// Número de préstamos desembolsados.
	measure 'Préstamos desembolsados' = COUNTROWS ( fact_prestamos )
		formatString: #,0
		displayFolder: Originación
		lineageTag: ffdf208e-f87b-4713-9a3a-26bfb683d7ac

	/// Valor total desembolsado.
	measure 'Monto desembolsado' = SUM ( fact_prestamos[monto_desembolsado] )
		formatString: \$ #,0
		displayFolder: Originación
		lineageTag: ebcafeb2-f3cc-4c50-ba45-cfa1467bce47

	/// Monto promedio por préstamo desembolsado.
	measure 'Ticket promedio' = DIVIDE ( [Monto desembolsado], [Préstamos desembolsados] )
		formatString: \$ #,0
		displayFolder: Originación
		lineageTag: d8ad0bfc-d066-4fd4-8a0b-cf4cab527f48

