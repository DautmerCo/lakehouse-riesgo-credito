table fact_cartera_mensual
	lineageTag: 4e9cbe02-69a1-4d16-b50d-5c2f0524c16e

	/// Último cierre de mes dentro del contexto. Ignora los filtros de mora para que todos los buckets se midan en la misma fecha.
	measure 'Fecha último cierre' =
			CALCULATE (
			    MAX ( fact_cartera_mensual[fecha_cierre] ),
			    REMOVEFILTERS (
			        fact_cartera_mensual[bucket_mora],
			        fact_cartera_mensual[bucket_orden],
			        fact_cartera_mensual[dias_mora]
			    )
			)
		formatString: dd/mm/yyyy
		displayFolder: Cartera
		lineageTag: 0eb3b708-5069-4042-b5e9-f9e79d03fa1c

	/// Saldo de capital en el último cierre del contexto. Es semiaditiva: no suma saldos de distintos cierres.
	measure 'Saldo cartera' =
			VAR UltimoCierre = [Fecha último cierre]
			RETURN
			    CALCULATE (
			        SUM ( fact_cartera_mensual[saldo_capital] ),
			        fact_cartera_mensual[fecha_cierre] = UltimoCierre
			    )
		formatString: \$ #,0
		displayFolder: Cartera
		lineageTag: a312ba57-3b29-483d-bfed-3d441e6acc7b

	/// Préstamos vigentes en el último cierre del contexto.
	measure 'Préstamos en cartera' =
			VAR UltimoCierre = [Fecha último cierre]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_cartera_mensual ),
			        fact_cartera_mensual[fecha_cierre] = UltimoCierre
			    )
		formatString: #,0
		displayFolder: Cartera
		lineageTag: 92d8caa3-083e-411e-afd0-502604978cb0

	/// Saldo de los préstamos con más de 30 días de mora.
	measure 'Saldo mora 30+' = CALCULATE ( [Saldo cartera], fact_cartera_mensual[dias_mora] > 30 )
		formatString: \$ #,0
		displayFolder: Cartera
		lineageTag: 4d7fb31e-96dd-4b7d-a24e-2ca388f1e8ae

	/// Indicador de calidad de cartera: saldo en mora 30+ sobre saldo total. En la matriz de cohortes da la mora de cada cohorte a cada edad.
	measure '% Mora 30+' = DIVIDE ( [Saldo mora 30+], [Saldo cartera] )
		formatString: 0.0%
		displayFolder: Cartera
		lineageTag: 6f446af2-af09-4aa6-b087-a5fe839a7092

	/// Participación de cada bucket de mora en el saldo total.
	measure '% Saldo' =
			DIVIDE (
			    [Saldo cartera],
			    CALCULATE (
			        [Saldo cartera],
			        REMOVEFILTERS ( fact_cartera_mensual[bucket_mora], fact_cartera_mensual[bucket_orden] )
			    )
			)
		formatString: 0.0%
		displayFolder: Cartera
		lineageTag: 5a99a7e6-220d-4cfe-a65c-004cce62a253

